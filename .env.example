# CONFIGURACOES: apenas no servidor. Nunca copiar para public/.
HOST=127.0.0.1
PORT=4317
PUBLIC_ORIGIN=http://localhost:4317,http://127.0.0.1:4317
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
AI_TIMEOUT_MS=20000
MAX_CONCURRENT_RUNS=2
RUNS_PER_HOUR=6
GLOBAL_RUNS_PER_HOUR=30
# Apenas se houver proxy confiavel na frente, sobrescrevendo X-Real-IP.
TRUST_PROXY=false
